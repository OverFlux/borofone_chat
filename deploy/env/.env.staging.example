APP_ENV=staging
APP_HOST=127.0.0.1
APP_PORT=8001
FORWARDED_ALLOW_IPS=*

PUBLIC_BASE_URL=https://staging-talk.example.com
PUBLIC_API_BASE_URL=
PUBLIC_WS_BASE_URL=
ALLOWED_ORIGINS=https://staging-talk.example.com

DATABASE_URL=postgresql+asyncpg://app:change-me@postgres:5432/borofone_staging
POSTGRES_DB=borofone_staging
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

REDIS_URL=redis://redis:6379/1
REDIS_DB=1

JWT_SECRET_KEY=change-me-to-a-long-random-string
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

HOST_DATA_ROOT=/var/lib/borofone/staging
BACKUP_ROOT=/var/backups/borofone
BACKUP_RCLONE_REMOTE=

# Always backed by host bind mount from ${HOST_DATA_ROOT}/uploads.
UPLOADS_DIR=/code/uploads
PAGES_DIR=pages
FAVICON_PATH=favicon.ico
MAIN_PAGE_PATH=main.html
LOGIN_PAGE_PATH=login.html
REGISTER_PAGE_PATH=register.html

MAX_AVATAR_BYTES=3145728

SMTP_HOST=smtp.transactional-provider.example
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=staging@staging-talk.example.com
SMTP_FROM_NAME=Borotalk staging
SMTP_STARTTLS=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

TURN_HOST=turn.talk.example.com
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_SHARED_SECRET=use-production-turn-secret-or-separate-staging-turn
TURN_CREDENTIAL_TTL_SECONDS=3600

SERVER_OWNER_LIMIT=5
REGISTRATION_RETENTION_DAYS=90
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
OFFICIAL_DESKTOP_HOST=https://staging-talk.example.com
RADMIN_IP=
