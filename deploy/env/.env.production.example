APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000
FORWARDED_ALLOW_IPS=*

PUBLIC_BASE_URL=https://talk.example.com
PUBLIC_API_BASE_URL=
PUBLIC_WS_BASE_URL=
ALLOWED_ORIGINS=https://talk.example.com

DATABASE_URL=postgresql+asyncpg://app:change-me@postgres:5432/borofone_prod
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=10
POSTGRES_DB=borofone_prod
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

REDIS_URL=redis://redis:6379/0
REDIS_DB=0

JWT_SECRET_KEY=change-me-to-a-long-random-string
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

HOST_DATA_ROOT=/var/lib/borofone/production
BACKUP_ROOT=/var/backups/borofone
BACKUP_RCLONE_REMOTE=

# Always backed by host bind mount from ${HOST_DATA_ROOT}/uploads.
UPLOADS_DIR=/code/uploads
PAGES_DIR=pages
FAVICON_PATH=favicon.ico
MAIN_PAGE_PATH=main.html
LOGIN_PAGE_PATH=login.html
REGISTER_PAGE_PATH=register.html

MAX_AVATAR_BYTES=3145728

# Preferred production provider. Keep secrets only in the VPS .env file.
EMAIL_PROVIDER=resend
RESEND_API_KEY=change-me
# Temporary owner-only smoke tests may set this to true. Disable it after
# verifying the custom sender domain and switching away from onboarding@resend.dev.
ALLOW_RESEND_TEST_SENDER=false
EMAIL_FROM_EMAIL=noreply@mail.example.com
EMAIL_FROM_NAME=Borotalk

# Optional fallback for legacy/self-hosted deployments.
SMTP_HOST=smtp.transactional-provider.example
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=hello@talk.example.com
SMTP_FROM_NAME=Borotalk
SMTP_STARTTLS=true

TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_BOT_USERNAME=change-me-without-at
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-url-safe-string

TURN_HOST=turn.talk.example.com
TURN_EXTERNAL_IP=203.0.113.10
TURN_PORT=3478
TURN_ALT_UDP_PORT=443
TURN_TLS_PORT=5349
TURN_SHARED_SECRET=change-me-to-a-long-random-string
TURN_CREDENTIAL_TTL_SECONDS=3600

SERVER_OWNER_LIMIT=5
REGISTRATION_RETENTION_DAYS=90
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
OFFICIAL_DESKTOP_HOST=https://talk.example.com

# Optional legacy self-host/Radmin compatibility. Leave empty on the VPS.
RADMIN_IP=
