[Unit]
Description=Borotalk API
After=network-online.target postgresql.service borotalk-redis.service
Wants=network-online.target
Requires=borotalk-redis.service

[Service]
Type=simple
User=borotalk
Group=borotalk
WorkingDirectory=/opt/borotalk
EnvironmentFile=/etc/borotalk/borotalk.env
ExecStart=/opt/borotalk/.venv-native/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
OOMScoreAdjust=500
MemoryHigh=160M
MemoryMax=210M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/borotalk/uploads

[Install]
WantedBy=multi-user.target
