[Unit]
Description=Borotalk TURN relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/turnserver -c /etc/borotalk/turnserver.conf
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
OOMScoreAdjust=700
MemoryHigh=96M
MemoryMax=128M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
