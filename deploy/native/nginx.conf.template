user www-data;
worker_processes 1;
pid /run/borotalk-nginx.pid;
error_log /var/log/borotalk/nginx-error.log warn;

events {
    worker_connections 512;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /var/log/borotalk/nginx-access.log;
    sendfile on;
    server_tokens off;
    client_max_body_size 5m;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    limit_req_zone $binary_remote_addr zone=borotalk_auth:10m rate=10r/m;

    upstream borotalk_api {
        server 127.0.0.1:8000;
        keepalive 16;
    }

    server {
        listen 80;
        server_name __PUBLIC_HOST__;
        return 308 https://$host$request_uri;
    }

    server {
        listen 443 ssl;
        server_name __PUBLIC_HOST__;

        ssl_certificate /etc/letsencrypt/live/borotalk/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/borotalk/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:BorotalkTLS:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;

        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), notifications=(self)" always;
        add_header Strict-Transport-Security "max-age=31536000" always;

        location ~ ^/auth/(login|register|password/forgot|password/reset|email/resend)$ {
            limit_req zone=borotalk_auth burst=10 nodelay;
            proxy_pass http://borotalk_api;
            include /etc/borotalk/proxy-headers.conf;
        }

        location / {
            proxy_pass http://borotalk_api;
            include /etc/borotalk/proxy-headers.conf;
        }
    }
}
