[Unit]
Description=Borotalk isolated Redis
After=network.target

[Service]
Type=simple
User=redis
Group=redis
ExecStart=/usr/bin/redis-server /etc/borotalk/redis.conf
Restart=on-failure
RestartSec=3
RuntimeDirectory=borotalk-redis
RuntimeDirectoryMode=0750
OOMScoreAdjust=650
MemoryHigh=56M
MemoryMax=64M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/borotalk/redis /run/borotalk-redis

[Install]
WantedBy=multi-user.target
