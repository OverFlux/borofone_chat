listening-ip=0.0.0.0
relay-ip=__PUBLIC_IP__
external-ip=__PUBLIC_IP__
listening-port=3478
tls-listening-port=5349
min-port=61000
max-port=61049
fingerprint
use-auth-secret
static-auth-secret=__TURN_SECRET__
realm=__TURN_HOST__
server-name=__TURN_HOST__
cert=/etc/letsencrypt/live/borotalk/fullchain.pem
pkey=/etc/letsencrypt/live/borotalk/privkey.pem
no-cli
no-multicast-peers
stale-nonce=600
proc-user=turnserver
proc-group=turnserver
pidfile=/run/borotalk-turn.pid
log-file=stdout
simple-log
