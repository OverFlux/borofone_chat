[Unit]
Description=Borotalk TURN UDP 443 fallback
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/turnserver -c /etc/borotalk/turnserver-udp443.conf
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
OOMScoreAdjust=725
MemoryHigh=64M
MemoryMax=96M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
